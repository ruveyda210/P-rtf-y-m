    <script>
        function showProject(skill) {

            let project = document.getElementById("project");

            if (skill === "python") {
                project.innerHTML =
                    "Python ile gelistirdigim projeleri burada gorebilirsin.";
            }

            else if (skill === "web") {
                project.innerHTML =
                    "HTML, CSS ve Flask ile web siteleri gelistiriyorum.";
            }

            else if (skill === "ai") {
                project.innerHTML =
                    "Yapay zeka ve goruntu isleme uzerine calismalar yapiyorum.";
            }
        }
